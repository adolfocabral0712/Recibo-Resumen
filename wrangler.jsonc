{
  "$schema": "./node_modules/wrangler/config-schema.json",

  "name": "dashboard-recibo-resumenes",

  "main": "src/index.js",

  "compatibility_date": "2026-07-28",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",

    "not_found_handling": "single-page-application",

    "run_worker_first": [
      "/api/*"
    ]
  }
}
